{
  "appId": "app.codrivemate.ch",
  "appName": "CoDriveMate",
  "webDir": "dist/app/browser",
  "server": {
    "androidScheme": "https",
    "iosScheme": "https"
  },
  "android": {
    "useLegacyBridge": true
  },
  "ios": {
    "contentInset": "never"
  },
  "plugins": {
    "Keyboard": {
      "resize": "none"
    },
    "BluetoothLe": {
      "displayStrings": {
        "scanning": "Suche Geräte…",
        "cancel": "Abbrechen",
        "availableDevices": "Verfügbare Geräte",
        "noDeviceFound": "Kein Gerät gefunden"
      }
    }
  }
}
